views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Clippings")
    groupBy:
      property: created
      direction: DESC
  - type: table
    name: View
    filters:
      and:
        - file.folder == "Clippings"
    groupBy:
      property: created
      direction: DESC
    order:
      - file.name
