views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Clippings")
        - file.ext == "md"
    groupBy:
      property: created
      direction: DESC
    order:
      - file.name
      - description
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 435
